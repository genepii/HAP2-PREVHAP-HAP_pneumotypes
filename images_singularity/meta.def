Bootstrap: docker
From: ubuntu:22.04


%environment
    export DEBIAN_FRONTEND=noninteractive
    export PATH=$PATH:/path/to/custom/bin

%labels
    Version 2024.8
    Author Audrey Lapendry
    Date 2024-08-05


%help
    SUMMARY
    Singularity container adapted from: 
    https://github.com/chanzuckerberg/czid-workflows/blob/main/workflows/long-read-mngs/Dockerfile
    KNOWN BUGS
    None
    USAGE
    Tools used to analyze metagenomic sequencing data.


%post
    export DEBIAN_FRONTEND=noninteractive
    
    sed -i s/archive.ubuntu.com/us-west-2.ec2.archive.ubuntu.com/ /etc/apt/sources.list
    echo 'APT::Install-Recommends "false";' > /etc/apt/apt.conf.d/98czid
    echo 'APT::Install-Suggests "false";' > /etc/apt/apt.conf.d/99czid
    apt-get -qq update

    apt-get -qq -y install \
        apt-utils \
        autoconf \
        automake \
        build-essential \
        bc \
        cmake \
        make \
        gcc \
        g++ \
        perl \
        libbz2-dev \
        liblzma-dev \
        libcurl4-gnutls-dev \
        libssl-dev \
        libncurses5-dev \
        libdeflate-dev \
        pandoc \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-wheel \
        python3-matplotlib \
        rsync \
        zlib1g-dev \
        default-jre \
        curl \
        gdb \
        git \
        httpie \
        jq \
        libfreetype6-dev \
        libhts-dev \
        libpng-dev \
        locales \
        minimap2 \
        moreutils \
        pigz \
        pkg-config \
        r-base \
        seqkit \
        seqtk \
        unzip \
        wget \
        zip \
        && locale-gen en_US.UTF-8
    
    pip3 install biopython multiqc RSeQC bamdash pandas

    Rscript -e "install.packages(c('rmarkdown', 'tidyverse', 'jsonlite'), repos='https://cloud.r-project.org')"

    # Install csvtk
    wget https://github.com/shenwei356/csvtk/releases/download/v0.30.0/csvtk_linux_amd64.tar.gz
    tar -zxvf csvtk_linux_amd64.tar.gz
    ls
    mv csvtk /usr/local/bin/

    # Add and set permissions for the clean_download_cache.sh script
    wget https://raw.githubusercontent.com/chanzuckerberg/miniwdl/v1.1.5/examples/clean_download_cache.sh -O /usr/local/bin/clean_download_cache.sh
    chmod +x /usr/local/bin/clean_download_cache.sh

    # Install FastQC
    wget https://www.bioinformatics.babraham.ac.uk/projects/fastqc/fastqc_v0.12.1.zip
    unzip fastqc_v0.12.1.zip -d /usr/local/bin/
    chmod -R +x /usr/local/bin/FastQC/fastqc
    ln -s /usr/local/bin/FastQC/fastqc /usr/local/bin/fastqc

    # Install FastQ Screen
    wget https://github.com/StevenWingett/FastQ-Screen/archive/refs/tags/v0.15.3.zip
    unzip v0.15.3.zip -d /usr/local/bin/FastQ_Screen
    chmod -R +x /usr/local/bin/FastQ_Screen/FastQ-Screen-0.15.3/fastq_screen
    ln -s /usr/local/bin/FastQ_Screen/FastQ-Screen-0.15.3/fastq_screen /usr/local/bin/fastq_screen
    ls /usr/local/bin/FastQ_Screen

    # Install fastp
    wget -O fastp http://opengene.org/fastp/fastp.0.23.4
    chmod a+x ./fastp
    mv fastp /usr/local/bin/fastp

    # Install bowtie2
    git clone --branch v2.5.4 https://github.com/BenLangmead/bowtie2.git
    cd bowtie2
    make
    mv bowtie2* /usr/local/bin/
    cd ..

    # Install samtools
    git clone --recursive --branch 1.20 https://github.com/samtools/htslib.git
    cd htslib
    autoreconf -i
    ./configure
    make
    make install
    cd ..
    git clone --branch 1.20 https://github.com/samtools/samtools.git
    cd samtools
    autoheader
    autoconf -Wno-syntax
    ./configure
    make
    make install
    cd ..

    # Install kraken2
    git clone --branch v2.1.3 https://github.com/DerrickWood/kraken2.git
    cd kraken2
    ./install_kraken2.sh /usr/local/bin

    # Install KrakenTools
    git clone --branch v1.2 https://github.com/jenniferlu717/KrakenTools.git
    cd KrakenTools
    chmod +x *.py
    mv *.py /usr/local/bin/
    ln -s /usr/bin/python3 /usr/bin/python

    # Install SPAdes
    wget https://github.com/ablab/spades/releases/download/v4.0.0/SPAdes-4.0.0.tar.gz
    tar -xzf SPAdes-4.0.0.tar.gz
    cd SPAdes-4.0.0
    PREFIX=/usr/local/ ./spades_compile.sh

    # Install BLAST
    # wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/LATEST/ncbi-blast-2.16.0+-x64-linux.tar.gz
    wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.16.0/ncbi-blast-2.16.0+-x64-linux.tar.gz
    tar -xzf ncbi-blast-2.16.0+-x64-linux.tar.gz
    mv ncbi-blast-2.16.0+/bin/* /usr/local/bin/

    # Install Diamond
    wget http://github.com/bbuchfink/diamond/releases/download/v2.1.9/diamond-linux64.tar.gz
    tar xzf diamond-linux64.tar.gz
    mv diamond /usr/local/bin/

    # Install bbmap
    wget https://sourceforge.net/projects/bbmap/files/BBMap_39.08.tar.gz/download -O bbmap.tar.gz
    tar -xvf bbmap.tar.gz
    rm bbmap.tar.gz
    cp -r bbmap/* /usr/local/bin
    rm -rf bbmap

    # Install quast.py
    git clone --branch quast_5.3.0 https://github.com/ablab/quast.git
    cd quast
    ./setup.py install_full

    # Install bwa-mem2
    curl -L https://github.com/bwa-mem2/bwa-mem2/releases/download/v2.2.1/bwa-mem2-2.2.1_x64-linux.tar.bz2 | tar jxf -
    mv bwa-mem2-2.2.1_x64-linux/* /usr/local/bin/

    # Install Qualimap
    wget https://bitbucket.org/kokonech/qualimap/downloads/qualimap_v2.3.zip
    ls
    unzip qualimap_v2.3.zip -d /usr/local/bin/qualimap_v2.3
    ls /usr/local/bin/qualimap_v2.3
    chmod +x /usr/local/bin/qualimap_v2.3/qualimap_v2.3/qualimap
    ls /usr/local/bin/qualimap_v2.3/qualimap_v2.3/qualimap
    ln -s /usr/local/bin/qualimap_v2.3/qualimap_v2.3/qualimap /usr/local/bin/qualimap

    # Install CD-HIT
    wget https://github.com/weizhongli/cdhit/releases/download/V4.8.1/cd-hit-v4.8.1-2019-0228.tar.gz
    tar xvf cd-hit-v4.8.1-2019-0228.tar.gz --gunzip
    cd cd-hit-v4.8.1-2019-0228
    make
    ls -l cd-hit*
    cd cd-hit-auxtools
    make
    ls
    mv * /usr/local/bin
    cd ..
    mv * /usr/local/bin

    rm -rf bowtie FastQ_Screen_v0.15.3.zip fastqc_v0.12.1.zip ncbi-blast-2.16.0+-x64-linux

%runscript
    exec "$@"
